                    }
                }
            }
        }
        else
        {
            // Patrol mode
            isChasing = false;
            float targetX = movingToB ? waypointBX : waypointAX;
            float targetZ = movingToB ? waypointBZ : waypointAZ;

            float pdx = targetX - myPos.x;
            float pdz = targetZ - myPos.z;
            float patrolDistSq = pdx * pdx + pdz * pdz;

            if (patrolDistSq < 1.0f)
