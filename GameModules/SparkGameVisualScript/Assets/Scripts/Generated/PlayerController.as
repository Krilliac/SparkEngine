    uint selfEntity = 0;
    float moveSpeed = 8.0f;
    float jumpForce = 5.0f;
    float health = 100.0f;
    float maxHealth = 100.0f;
    bool isGrounded = true;
    float verticalVelocity = 0.0f;
    float gravity = -16.0f;

    void Start()
