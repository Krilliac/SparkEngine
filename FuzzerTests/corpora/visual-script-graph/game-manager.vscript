    {"id": 5, "type": "PrintMessage", "position": [960, 0], "inputs": [{"kind": "Execution"}, {"kind": "String", "default": "Controls: WASD + Space to jump, Shift to sprint"}], "outputs": [{"kind": "Execution"}]},
    {"id": 6, "type": "PrintMessage", "position": [1200, 0], "inputs": [{"kind": "Execution"}, {"kind": "String", "default": "Console: vs_status shows progress, vs_restart resets the demo"}], "outputs": [{"kind": "Execution"}]},
    {"id": 7, "type": "PrintMessage", "position": [1440, 0], "inputs": [{"kind": "Execution"}, {"kind": "String", "default": "=========================="}], "outputs": [{"kind": "Execution"}]},
