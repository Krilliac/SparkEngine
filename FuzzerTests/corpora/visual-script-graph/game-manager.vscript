{
  "format": "spark.vscript",
  "version": 1,
  "className": "GameManager",
  "description": "Tracks score, collectibles remaining, and win/lose conditions.\nSource graph: GameModules/SparkGameVisualScript/Assets/Graphs/GameManager.vscript. Edit the graph and\nregenerate this file (see the module README); do not edit it by hand.",
  "variables": [
    {"name": "score", "type": "Int", "default": "0"},
    {"name": "totalCoins", "type": "Int", "default": "5"},
    {"name": "coinsCollected", "type": "Int", "default": "0"},
    {"name": "gameTime", "type": "Float", "default": "0.0f"},
    {"name": "gameOver", "type": "Bool", "default": "false"},
    {"name": "gameWon", "type": "Bool", "default": "false"}
  ],
  "nodes": [
