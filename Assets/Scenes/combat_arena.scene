# Spark Engine Scene File - Combat Arena
# Enhanced FPS level with class-based gameplay areas
# Inspired by PlanetSide 2 / Battlefield conquest maps

[Scene]
name=Combat Arena
author=Spark Engine
version=1.0
skybox=default
ambientLight=0.3,0.35,0.45
fogColor=0.5,0.55,0.65
fogStart=80.0
fogEnd=200.0

[Terrain]
type=plane
width=200.0
depth=200.0
position=0.0,-1.0,0.0
material=ground_dirt

