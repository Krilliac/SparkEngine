# TERRAFRONT - Veyra Highlands (continent 2, W12 continent-2-data lane)
# Generated from Assets/MMOFPS/Data/regions_highlands.json - keep in sync with it.
# Salt-flat highlands split by a deep north-south rift (the Riftglass canyon);
# Riftglass Refinery and Shalecrown Depot are plateau islands rising from the rift.
# Heightfield: procedural, tf* params below are parsed by TFWorldSetup per-scene.
# Every object Y equals its region plateau height so nothing floats or sinks.
# EXCEPTION - mesa_* cliff cubes are sunk 1.0 m (top face = plateau - 1.0):
# coplanar top faces z-fight with the terrain mesh (same rule as cindral_wastes).
# Free-standing rift rocks sit at exact procedural terrain height - 0.6 m sink
# (all are >= 320 m from every region center, so plateau blending is zero there).

[Scene]
name=Veyra Highlands
author=TERRAFRONT
version=1.0
# sky/fog keys are forward-looking; current .scene parser ignores them
skybox=Assets/Textures/MMOFPS/sky/space
ambientLight=0.46,0.44,0.40
fogColor=0.72,0.76,0.82
fogStart=500.0
fogEnd=3000.0

# ============================================================
# TERRAIN - salt highlands + central rift, 4096m x 4096m, origin SW corner
# ============================================================

[Terrain]
type=plane
position=2048.0,0.0,2048.0
scale=4096.0,1.0,4096.0
material=Assets/Materials/MMOFPS/Terrain_Salt.json
# --- TF procedural heightfield params (read by TFWorldSetup) ---
tfBaseHeight=26.0
tfDuneAmp=2.5
tfDunePeriodX=0.0031
tfDunePeriodZ=0.0044
tfRidgeAmp=4.5
tfCanyonX=2048.0
tfCanyonHalfWidth=230.0
tfCanyonZ0=1000.0
tfCanyonZ1=3050.0
tfCanyonDepth=30.0
tfPlateauRadius=120.0
tfPlateauSkirt=180.0
tfPlateauSkyanchor=58.0
tfPlateauFort=48.0
tfPlateauFacility=36.0
tfPlateauOutpost=42.0

