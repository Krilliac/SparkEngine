# TERRAFRONT - Cindral Wastes (continent 1)
# Generated from Assets/MMOFPS/Data/regions.json - keep in sync with it.
# Heightfield: procedural, params below (tf* keys) are parsed by
# TFWorldSetup and MUST match TFTerrainParams defaults. Every object Y
# equals its region plateau height so nothing floats or sinks.

[Scene]
name=Cindral Wastes
author=TERRAFRONT
version=1.0
# sky/fog keys are forward-looking; current .scene parser ignores them
skybox=Assets/Textures/MMOFPS/sky/space
ambientLight=0.42,0.36,0.30
fogColor=0.78,0.62,0.45
fogStart=600.0
fogEnd=3200.0

# ============================================================
# TERRAIN - desert mesa continent, 4096m x 4096m, origin SW corner
# ============================================================

[Terrain]
type=plane
position=2048.0,0.0,2048.0
scale=4096.0,1.0,4096.0
material=Assets/Materials/MMOFPS/Terrain_Rock.json
# --- TF procedural heightfield params (read by TFWorldSetup) ---
tfBaseHeight=8.0
tfDuneAmp=4.0
tfDunePeriodX=0.0040
tfDunePeriodZ=0.0035
tfRidgeAmp=2.0
tfCanyonX=2048.0
tfCanyonHalfWidth=260.0
tfCanyonZ0=250.0
tfCanyonZ1=1550.0
tfCanyonDepth=16.0
tfPlateauRadius=120.0
tfPlateauSkirt=180.0
tfPlateauSkyanchor=40.0
tfPlateauFort=30.0
tfPlateauFacility=26.0
tfPlateauOutpost=20.0

