{
    "name": "TownSquare",
    "version": 1,
    "description": "Safe zone social hub - the heart of the MMO world. Markets, guilds, and NPCs.",
    "areaId": 1,
    "maxPlayers": 128,
    "pvpEnabled": false,
    "entities": [
