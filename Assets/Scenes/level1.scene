# Spark Engine Scene File - FPS Arena (Level 1)
# Objects previously hardcoded in GameSetup.cpp and ArenaBuilder.cpp
# can now be placed/edited in the editor without recompiling.
#
# Format: [Section] followed by key=value properties
# Supports: Object, SpawnPoint, Light, Camera, TriggerVolume,
#           ForceRegion, Interaction, Vehicle, Enemy, DamageZone

[Scene]
name=FPS Arena
author=Spark Engine
version=2.0
skybox=default
ambientLight=0.3,0.35,0.45
fogColor=0.5,0.55,0.65
fogStart=80.0
fogEnd=200.0

# ============================================================
# TERRAIN
# ============================================================

[Terrain]
type=plane
width=50.0
depth=50.0
position=0.0,-0.5,0.0
material=ground_dirt

# ============================================================
# CAMERA (was hardcoded in Game.cpp line 95)
# ============================================================

[Camera]
position=0.0,2.0,-5.0
projection=perspective
nearPlane=0.1
farPlane=1000.0
isMain=true
name=MainCamera

