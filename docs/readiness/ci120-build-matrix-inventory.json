{
  "cmakeOptions": [
    {
      "name": "BUILD_GAME_MODULES",
      "description": "Build in-tree game modules (SparkGameFPS, SparkGameMMO, etc.)",
      "default": "ON"
    },
    {
      "name": "BUILD_TESTS",
      "description": "Build test suite",
      "default": "ON"
    },
    {
      "name": "ENABLE_ANGELSCRIPT",
      "description": "Enable the AngelScript gameplay scripting runtime",
      "default": "ON"
    },
    {
      "name": "ENABLE_ASSET_PIPELINE_TOOLS",
      "description": "Build deterministic cooker and worker processes",
      "default": "ON"
    },
    {
      "name": "ENABLE_AUTOMATION_HOST",
      "description": "Build the standalone automation host",
      "default": "ON"
    },
    {
      "name": "ENABLE_CONSOLE_IN_SHIPPING",
      "description": "Include SparkConsole in Shipping builds",
      "default": "OFF"
    },
    {
      "name": "ENABLE_DEVCOMMANDS_IN_SHIPPING",
      "description": "Include developer commands (god, noclip, etc.) in Shipping builds",
      "default": "OFF"
    },
    {
      "name": "ENABLE_DXR",
      "description": "Enable DirectX Raytracing support (requires D3D12, runtime fallback to SDFGI)",
      "default": "ON"
    },
    {
      "name": "ENABLE_EDITOR",
      "description": "Enable editor features",
      "default": "ON"
    },
    {
      "name": "ENABLE_GRAPHICS",
      "description": "Enable graphics engine",
      "default": "ON"
    },
    {
      "name": "ENABLE_HYBRID_RT",
      "description": "Enable hybrid ray tracing (SDFGI software + optional hardware DXR/Vulkan RT)",
      "default": "ON"
    },
    {
      "name": "ENABLE_INSTALLER",
      "description": "Build SparkInstaller (bootstrap installer/updater)",
      "default": "ON"
    },
    {
      "name": "ENABLE_LAUNCHER",
      "description": "Build SparkLauncher (Unity-Hub-style project picker)",
      "default": "ON"
    },
    {
      "name": "ENABLE_LTO",
      "description": "Enable link-time optimization in Release/MinSizeRel builds",
      "default": "ON"
    },
    {
      "name": "ENABLE_METAL",
      "description": "Enable Metal graphics backend (macOS, experimental)",
      "default": "${APPLE}"
    },
    {
      "name": "ENABLE_MOBILE",
      "description": "Enable mobile platform support (touch, gestures, battery-aware scaling)",
      "default": "OFF"
    },
    {
      "name": "ENABLE_NETWORKING",
      "description": "Enable networking features (UDP sockets)",
      "default": "ON"
    },
    {
      "name": "ENABLE_NEURAL_RENDERING",
      "description": "Enable neural rendering features (NTC, radiance cache, neural post-processing)",
      "default": "ON"
    },
    {
      "name": "ENABLE_OPENGL",
      "description": "Enable OpenGL graphics backend (experimental)",
      "default": "ON"
    },
    {
      "name": "ENABLE_PROFILING",
      "description": "Enable profiling tools",
      "default": "ON"
    },
    {
      "name": "ENABLE_RECAST",
      "description": "Enable Recast/Detour navmesh generation (improved voxel-based builder)",
      "default": "ON"
    },
    {
      "name": "ENABLE_SDL2",
      "description": "Enable SDL2 cross-platform input and windowing",
      "default": "platform-conditional"
    },
    {
      "name": "ENABLE_SERVER_PROCESSES",
      "description": "Build dedicated server, gateway, and orchestration processes",
      "default": "ON"
    },
    {
      "name": "ENABLE_SPARKBUILD",
      "description": "Build SparkBuild (terminal-UI CMake configurator)",
      "default": "ON"
    },
    {
      "name": "ENABLE_VR",
      "description": "Enable VR/AR framework (OpenXR-ready stub)",
      "default": "OFF"
    },
    {
      "name": "ENABLE_VULKAN",
      "description": "Enable Vulkan graphics backend (experimental)",
      "default": "ON"
    },
    {
      "name": "SPARK_DOUBLE_PRECISION_PHYSICS",
      "description": "Enable double precision physics (JPH_DOUBLE_PRECISION) for large worlds",
      "default": "OFF"
    },
    {
      "name": "SPARK_HEADLESS_SUPPORT",
      "description": "Enable headless/dedicated server mode support",
      "default": "ON"
    },
    {
      "name": "SPARK_NATIVE_ARCH",
      "description": "Tune for the build machine's CPU (SSE4.2/AVX2/etc). Disable for distributed binaries.",
      "default": "OFF"
    },
    {
      "name": "SPARK_STRICT_DEPS",
      "description": "FATAL_ERROR on missing critical dependencies (Jolt, ImGui, EnTT)",
      "default": "OFF"
    },
    {
      "name": "SPARK_SUPPRESS_THIRDPARTY_WARNINGS",
      "description": "Suppress compiler warnings from third-party libraries (Jolt, etc.)",
      "default": "ON"
    },
    {
      "name": "STRIP_DEBUG_SYMBOLS",
      "description": "Strip debug symbols from the final binary",
      "default": "OFF"
    }
  ],
