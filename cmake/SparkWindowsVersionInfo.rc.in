#include <winver.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @SPARK_VERSION_MAJOR@,@SPARK_VERSION_MINOR@,@SPARK_VERSION_PATCH@,0
    PRODUCTVERSION @SPARK_VERSION_MAJOR@,@SPARK_VERSION_MINOR@,@SPARK_VERSION_PATCH@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SparkEngine"
            VALUE "FileDescription", "@SPARK_VERSION_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@SPARK_VERSION_STRING@"
            VALUE "InternalName", "@SPARK_VERSION_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@SPARK_VERSION_ORIGINAL_FILENAME@"
            VALUE "ProductName", "@SPARK_VERSION_PRODUCT_NAME@"
            VALUE "ProductVersion", "@SPARK_VERSION_STRING@"
            VALUE "LegalCopyright", "Copyright (C) SparkEngine contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
