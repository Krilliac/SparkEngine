@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT WIN32 OR @SPARK_PACKAGE_HAS_ANGELSCRIPT@)
    find_dependency(Threads REQUIRED)
endif()

if(@SPARK_PACKAGE_HAS_CURL@)
    find_dependency(CURL REQUIRED)
endif()

if(@SPARK_PACKAGE_HAS_SDL2@)
    find_dependency(SDL2 REQUIRED)
endif()

if(@SPARK_PACKAGE_HAS_OPENAL@)
    # The exporting build linked the imported OpenAL::OpenAL target (openal-soft
    # or the system framework via FindOpenAL). Mirror the root CMakeLists probe
    # so Homebrew's openal-soft is preferred before the deprecated macOS
    # framework, then re-import the target SparkEngineTargets.cmake refers to.
    if(APPLE)
        foreach(_spark_brew_prefix /opt/homebrew /usr/local)
            if(EXISTS "${_spark_brew_prefix}/opt/openal-soft/include/AL/al.h")
                list(APPEND CMAKE_PREFIX_PATH "${_spark_brew_prefix}/opt/openal-soft")
                break()
            endif()
        endforeach()
        unset(_spark_brew_prefix)
    endif()
    find_dependency(OpenAL REQUIRED)
endif()

if(NOT TARGET OpenGL::GL)
    find_package(OpenGL QUIET)
endif()
if(NOT TARGET Vulkan::Vulkan)
    find_package(Vulkan QUIET)
endif()
if(NOT TARGET X11::X11)
    find_package(X11 QUIET)
endif()
if(NOT TARGET SDL2::SDL2 AND NOT TARGET SDL2)
    find_package(SDL2 QUIET)
endif()

# Define package paths before loading SparkGameModule.cmake: that helper reads
# the installed Spark/Version.h immediately to derive the module ABI sidecar.
set(SPARK_ENGINE_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(SPARK_ENGINE_SDK_DIR "${PACKAGE_PREFIX_DIR}/include/Spark")
set(SPARK_ENGINE_FOUND TRUE)

include("${CMAKE_CURRENT_LIST_DIR}/SparkEngineTargets.cmake")

# SparkEngineInterface intentionally carries no link dependency on the static
# engine archive. Reuse that imported target's compile-time ABI requirements so
# installed POSIX modules match the host while leaving symbols for dlopen().
if(TARGET Spark::SparkEngineInterface)
    set_property(TARGET Spark::SparkEngineInterface PROPERTY
        INTERFACE_COMPILE_DEFINITIONS
        "$<TARGET_PROPERTY:Spark::SparkEngineLib,INTERFACE_COMPILE_DEFINITIONS>")
    # Public engine headers include <SDL.h> and <AL/al.h> whenever the matching
    # SPARK_*_AVAILABLE definition above is set, so an installed module needs the
    # dependency include directories carried by SparkEngineLib's link interface
    # (SDL2::SDL2, OpenAL::OpenAL, ...) even though it links no engine objects.
    set_property(TARGET Spark::SparkEngineInterface APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES
        "$<TARGET_PROPERTY:Spark::SparkEngineLib,INTERFACE_INCLUDE_DIRECTORIES>")
endif()

if(WIN32)
    set(SPARK_ENGINE_LIBRARIES Spark::SparkEngineLib)
else()
    set(SPARK_ENGINE_LIBRARIES Spark::SparkEngineInterface)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SparkGameModule.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SparkPlugin.cmake")

check_required_components(SparkEngine)
