        "max_corpus_bytes": 16384,
        "smoke_seconds": 10
      },
      "regressions": [
        {
          "file": "regression-data-uri-length-overclaim.gltf",
          "finding": "A base64 data URI declaring a 300 MB byteLength made cgltf_load_buffers allocate the declared size (up to 1 GiB) from a 373-byte file before decoding; ValidateDocumentStructure now rejects a byteLength the payload cannot fill.",
          "found_by": "smoke",
          "guard_test": "FuzzGltfSmoke"
        },
        {
          "file": "regression-misaligned-index-accessor.glb",
          "finding": "A uint16 index accessor at an odd buffer-view byteOffset made cgltf_validate read indices through a misaligned typed pointer (UBSan); ValidateAccessorBounds now requires view offset, accessor offset and stride to be multiples of the component size.",
          "found_by": "campaign",
          "guard_test": "FuzzGltfSmoke"
        },
        {
          "file": "regression-glb-bin-unaligned.glb",
          "finding": "A GLB whose JSON chunk length is not a multiple of 4 placed the in-place BIN buffer at an odd address, so every typed accessor read was misaligned (UBSan); ValidateDocumentStructure now rejects an unaligned BIN chunk.",
          "found_by": "review",
          "guard_test": "FuzzGltfSmoke"
        },
        {
          "file": "regression-generated-normal-overflow.glb",
          "finding": "A static mesh without NORMAL whose finite positions reach ~1e29 overflowed the float cross products in GenerateNormals, so LoadGLTFStaticMesh published NaN normals; the normals are now accumulated and normalized in double.",
          "found_by": "campaign",
          "guard_test": "FuzzGltfSmoke"
        }
      ]
    },
