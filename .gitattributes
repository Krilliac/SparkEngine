###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto
*.sh text eol=lf
# Asset integrity hashes the bytes that are packaged. Treat the first-party
# asset tree as opaque bytes so Git never rewrites line endings at checkout.
# Exception: .obj/.mtl are text-normalized to LF (see below), so their
# manifest hashes describe LF-normalized bytes, not raw committed blobs.
Assets/** -text
# A trailing ** does not match a direct child in every Git attributes parser;
# cover direct Asset-root files such as Assets/README.md explicitly as well.
Assets/* -text
# Blender MMO provenance hashes bind the authoring script and license bytes.
# Keep both LF-stable so Windows autocrlf cannot invalidate the evidence.
tools/blender/author_mmo_props.py text eol=lf
LICENSE text eol=lf
# Runtime-sheet descriptors are content-addressed in Templates/assets.lock.json.
# Keep their on-disk bytes stable across Windows, Linux, and macOS checkouts.
Templates/*/Assets/runtime_sheet.json text eol=lf
# Wavefront .obj/.mtl are text-normalized to LF. This OVERRIDES the -text
# rule above for these extensions. Their integrity hashes describe the
# LF-normalized checkout bytes, not opaque blobs. This ensures stable
# cross-platform hashes regardless of autocrlf settings.
Assets/**/*.obj text eol=lf
Assets/**/*.mtl text eol=lf
Templates/*/Assets/**/*.obj text eol=lf
Templates/*/Assets/**/*.mtl text eol=lf
# Readiness evidence is compared byte-for-byte against freshly generated output
# (inventory.py --check, check_parity.py --baseline). Windows autocrlf would
# rewrite these on checkout and make the comparison fail for no real reason.
docs/readiness/*.json text eol=lf
docs/site/readiness.json text eol=lf
# Unified-diff context markers intentionally contain leading spaces before
# upstream tab indentation. Git-apply separately enforces target whitespace.
ThirdParty/Scripting/patches/angelscript-packed-bytecode.patch text eol=lf -whitespace
# Generated documentation is compared byte-for-byte with fresh output.
# Keep every tracked manifest output LF-stable on Windows checkouts too.
README.md text eol=lf
CLAUDE.md text eol=lf
.github/copilot-instructions.md text eol=lf
.github/prompts/copilot-instructions.md text eol=lf
.github/prompts/build-test.prompt.md text eol=lf
.github/badges/*.json text eol=lf
wiki/Home.md text eol=lf
wiki/advanced/Testing.md text eol=lf
wiki/advanced/Codebase-Statistics.md text eol=lf
wiki/gameplay-tools/SparkEditor.md text eol=lf
wiki/subsystems/Entity-Component-System.md text eol=lf
wiki/reference/Symbol-Index.md text eol=lf
wiki/reference/Function-Index.md text eol=lf
wiki/reference/Class-Index.md text eol=lf
wiki/reference/Enum-Index.md text eol=lf
wiki/reference/Macro-Index.md text eol=lf
wiki/reference/File-Tree.md text eol=lf
wiki/reference/Class-Hierarchy.md text eol=lf
wiki/getting-started/Engine-Architecture-Flowchart.md text eol=lf
# This must follow the generic README.md rule above: the root asset README is
# hashed as packaged content rather than treated as generated documentation.
Assets/README.md -text

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain
# Content-addressed package assets: the manifest SHA-256 covers exact bytes,
# so the generated scripts (and the manifest itself) must stay LF on every
# checkout; Windows autocrlf rewrote them and broke the asset-integrity job.
GameModules/*/Assets/manifest.json text eol=lf
GameModules/*/Assets/**/*.as text eol=lf
