      "source": "Tools/spark-cli/README.md",
      "claim": "new copies a template into <output>/<name> and rewrites the template name in file contents and file names.",
      "commands": ["new"],
      "flags": ["--template", "--output"],
      "tests": [
        "test_spark_cli.SparkNewTests.test_new_rewrites_project_descriptor_identity_before_renaming",
        "test_spark_cli.SparkNewFromInstalledPrefixTests.test_new_from_installed_prefix_uses_share_templates"
      ]
    },
    {
