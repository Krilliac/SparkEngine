{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkengine.dev/schemas/certification-evidence-v1.json",
  "title": "SparkEngine Certification Evidence Record",
  "description": "Machine-readable proof that a support-matrix row was exercised on a physical or CI host. Every field is required for the row to certify — missing or mismatched fields fail closed. Evidence records are immutable: a new commit requires a new record.",
  "type": "object",
  "required": [
    "schemaVersion",
    "rowId",
    "commitSha",
    "collectedAt",
    "collector",
    "host",
    "probes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "rowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Must match a row.id in the support matrix."
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact git commit SHA of the tested source. Must match the matrix commitSha."
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evidence collection."
    },
    "collector": {
      "type": "object",
      "required": ["type", "identity", "provenance", "attestation"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["ci", "manual", "automated"],
          "description": "How evidence was collected."
        },
        "identity": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512,
          "description": "CI run URL, operator name, or automation script path."
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "CI run ID if applicable."
        },
        "provenance": {
          "type": "object",
          "required": [
            "repository",
            "workflow",
            "runId",
            "runAttempt",
            "jobId",
            "checkoutAt",
            "commitSha"
          ],
          "additionalProperties": false,
          "description": "Where this record was produced. Bound to an externally supplied revision; a record whose provenance does not match the expected repository, workflow and SHA cannot certify.",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
              "description": "owner/name, e.g. from GITHUB_REPOSITORY."
            },
            "workflow": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Workflow name, e.g. from GITHUB_WORKFLOW."
            },
            "runId": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$",
              "description": "Run identifier, e.g. from GITHUB_RUN_ID."
            },
            "runAttempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "description": "Run attempt, e.g. from GITHUB_RUN_ATTEMPT."
            },
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Job identifier, e.g. from GITHUB_JOB."
            },
            "checkoutAt": {
              "type": "string",
              "format": "date-time",
              "description": "When the source was checked out. Evidence must be collected strictly after this instant."
            },
            "commitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Revision the collector checked out, e.g. from GITHUB_SHA."
            }
          }
        },
        "attestation": {
          "type": "object",
          "required": ["predicateType", "bundleSha256", "signedAt"],
          "additionalProperties": false,
          "description": "Binds this record to the measured content of the evidence bundle.",
          "properties": {
            "predicateType": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200,
              "description": "Attestation predicate URI."
            },
            "bundleSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 over the sorted (path, sha256) list of every artifact this record declares."
            },
            "signedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "required": ["os", "arch", "cpu", "ram", "gpu", "audio", "compiler"],
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "object",
          "required": ["family", "version", "build", "locale"],
          "additionalProperties": false,
          "properties": {
            "family": { "enum": ["windows", "linux", "macos"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "build": { "type": "string", "minLength": 1, "maxLength": 100 },
            "locale": { "type": "string", "minLength": 2, "maxLength": 35 }
          }
        },
        "arch": { "enum": ["x86_64", "aarch64"] },
        "cpu": {
          "type": "object",
          "required": ["model", "features"],
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 200 },
            "features": {
              "type": "array",
              "maxItems": 128,
              "items": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        },
        "ram": {
          "type": "object",
          "required": ["totalMb"],
          "additionalProperties": false,
          "properties": {
            "totalMb": { "type": "integer", "minimum": 1, "maximum": 16777216 }
          }
        },
        "gpu": {
          "type": "object",
          "required": ["api", "device", "vendor", "driverVersion", "featureLevel"],
          "additionalProperties": false,
          "properties": {
            "api": { "enum": ["d3d11", "d3d12", "vulkan", "opengl", "metal", "nullrhi"] },
            "device": { "type": "string", "minLength": 1, "maxLength": 200 },
            "vendor": { "enum": ["nvidia", "amd", "intel", "apple", "microsoft", "mesa", "none"] },
            "driverVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
            "featureLevel": { "type": "string", "minLength": 1, "maxLength": 40 },
            "vramMb": { "type": "integer", "minimum": 0, "maximum": 1048576 }
          }
        },
        "audio": {
          "type": "object",
          "required": ["api"],
          "additionalProperties": false,
          "properties": {
            "api": { "enum": ["xaudio2", "openal", "none"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 40 },
            "deviceName": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "compiler": {
          "type": "object",
          "required": ["id", "version", "toolset"],
          "additionalProperties": false,
          "properties": {
            "id": { "enum": ["msvc", "gcc", "clang", "apple-clang", "mingw"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "toolset": { "type": "string", "minLength": 1, "maxLength": 40 },
            "windowsSdkVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "description": "One entry per evidence category. Each probe is pass/fail with structured detail.",
      "additionalProperties": false,
      "properties": {
        "build":              { "$ref": "#/$defs/Probe" },
        "install":            { "$ref": "#/$defs/Probe" },
        "launch":             { "$ref": "#/$defs/Probe" },
        "renderer":           { "$ref": "#/$defs/Probe" },
        "content":            { "$ref": "#/$defs/Probe" },
        "input":              { "$ref": "#/$defs/Probe" },
        "audio":              { "$ref": "#/$defs/Probe" },
        "save":               { "$ref": "#/$defs/Probe" },
        "crash":              { "$ref": "#/$defs/Probe" },
        "upgrade":            { "$ref": "#/$defs/Probe" },
        "rollback":           { "$ref": "#/$defs/Probe" },
        "uninstall":          { "$ref": "#/$defs/Probe" },
        "dependency_closure": { "$ref": "#/$defs/Probe" }
      }
    },
    "dependencyClosure": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/RuntimeDependency" },
      "description": "Every runtime dependency the installed product requires."
    },
    "staleBefore": {
      "type": "string",
      "format": "date-time",
      "description": "If set, evidence older than this timestamp is rejected even if commit matches."
    }
  },
  "$defs": {
    "Probe": {
      "type": "object",
      "required": ["status", "durationMs"],
      "additionalProperties": false,
      "description": "A single probe result. A 'pass' additionally requires exitCode 0, a positive duration, startedAt/completedAt chronology and at least one artifact -- see the validator; those cross-field rules are not expressible in Draft 2020-12.",
      "properties": {
        "status": {
          "enum": ["pass", "fail", "skip", "error"],
          "description": "pass=verified, fail=tested and failed, skip=intentionally skipped with reason, error=could not run."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000,
          "description": "Wall-clock milliseconds the probe took."
        },
        "detail": {
          "type": "string",
          "maxLength": 2000,
          "description": "Human-readable detail or error message."
        },
        "artifacts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "sizeBytes"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Forward-slash relative path beneath the evidence bundle root. Resolved, opened without following links, and hashed by the validator; the declared digest and size must match the measured ones."
              },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sizeBytes": { "type": "integer", "minimum": 0 }
            }
          },
          "description": "Artifacts produced by this probe (logs, screenshots, crash dumps)."
        },
        "exitCode": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Process exit code. Required and must be 0 when status is 'pass'."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the probe began. Required when status is 'pass'."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the probe finished. Required when status is 'pass'; must be after startedAt and consistent with durationMs."
        },
        "skipReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Required when status is 'skip'."
        }
      }
    },
    "RuntimeDependency": {
      "type": "object",
      "required": ["name", "version", "source", "path", "sha256", "sizeBytes"],
      "additionalProperties": false,
      "description": "One entry of a real package scan. Every entry names a file inside the evidence bundle that the validator opens and measures; a dependency that cannot be measured cannot be claimed.",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 260 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source": {
          "enum": ["system", "bundled", "vcredist", "directx", "sdk"],
          "description": "Where this dependency comes from."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Forward-slash relative path beneath the evidence bundle root."
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
