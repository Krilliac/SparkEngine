{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkengine.dev/schemas/support-matrix-v1.json",
  "title": "SparkEngine Platform Support Matrix",
  "description": "Deterministic declaration of every certified platform support row for a release profile. Each row is an exact combination of OS, architecture, compiler, GPU, driver, and audio that the engine claims to support. Rows without complete evidence cannot be certified.",
  "type": "object",
  "required": ["schemaVersion", "profile", "commitSha", "generatedAt", "rows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema version for forward compatibility."
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Release profile ID this matrix certifies (e.g. 'stable-v1')."
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact full git commit SHA this matrix was generated against."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of matrix generation."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SupportRow" },
      "description": "One entry per certified combination."
    }
  },
  "$defs": {
    "SupportRow": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "os",
        "arch",
        "compiler",
        "gpu",
        "audio",
        "evidenceRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable row identifier (e.g. 'win11-x64-msvc143-d3d11-rtx5070ti')."
        },
        "tier": {
          "enum": ["primary", "supported", "experimental", "unsupported"],
          "description": "Support level. Only 'primary' and 'supported' may appear in release claims."
        },
        "os": { "$ref": "#/$defs/OsSpec" },
        "arch": {
          "type": "string",
          "enum": ["x86_64", "aarch64"],
          "description": "CPU architecture."
        },
        "compiler": { "$ref": "#/$defs/CompilerSpec" },
        "gpu": { "$ref": "#/$defs/GpuSpec" },
        "audio": { "$ref": "#/$defs/AudioSpec" },
        "cpuFeatures": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "description": "Required CPU instruction sets (e.g. 'SSE4.2', 'AVX2')."
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "build",
              "install",
              "launch",
              "renderer",
              "content",
              "input",
              "audio",
              "save",
              "crash",
              "upgrade",
              "rollback",
              "uninstall",
              "dependency_closure"
            ]
          },
          "uniqueItems": true,
          "description": "Evidence categories required for this row to be certified."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Human-readable notes about this row's scope or limitations."
        }
      }
    },
    "OsSpec": {
      "type": "object",
      "required": ["family", "version", "build"],
      "additionalProperties": false,
      "properties": {
        "family": { "enum": ["windows", "linux", "macos"] },
        "version": {
          "type": "string",
          "description": "OS marketing version (e.g. '11', '24.04', '14')."
        },
        "build": {
          "type": "string",
          "description": "Exact OS build number (e.g. '10.0.22631', '6.8.0-45-generic')."
        }
      }
    },
    "CompilerSpec": {
      "type": "object",
      "required": ["id", "version", "toolset"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": ["msvc", "gcc", "clang", "apple-clang", "mingw"],
          "description": "Compiler family."
        },
        "version": {
          "type": "string",
          "description": "Exact compiler version string (e.g. '19.42.34435')."
        },
        "toolset": {
          "type": "string",
          "description": "Toolset identifier (e.g. 'v143', 'v145')."
        },
        "windowsSdkVersion": {
          "type": "string",
          "description": "Windows SDK version when applicable (e.g. '10.0.22621.0')."
        }
      }
    },
    "GpuSpec": {
      "type": "object",
      "required": ["api", "device", "vendor", "driverVersion", "featureLevel"],
      "additionalProperties": false,
      "properties": {
        "api": {
          "enum": ["d3d11", "d3d12", "vulkan", "opengl", "metal", "nullrhi"],
          "description": "Graphics API."
        },
        "device": {
          "type": "string",
          "description": "GPU device name as reported by the driver."
        },
        "vendor": {
          "enum": ["nvidia", "amd", "intel", "apple", "microsoft", "mesa", "none"],
          "description": "GPU vendor."
        },
        "driverVersion": {
          "type": "string",
          "description": "Exact driver version string. 'none' for NullRHI."
        },
        "featureLevel": {
          "type": "string",
          "description": "API feature level (e.g. '11.1', '12.0', '1.3', 'null')."
        }
      }
    },
    "AudioSpec": {
      "type": "object",
      "required": ["api"],
      "additionalProperties": false,
      "properties": {
        "api": {
          "enum": ["xaudio2", "openal", "none"],
          "description": "Audio API."
        },
        "version": {
          "type": "string",
          "description": "Audio API version if applicable."
        }
      }
    }
  }
}
